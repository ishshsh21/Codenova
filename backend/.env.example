# --- App ---
APP_SECRET_KEY=                   # generate with: python -c "import secrets;print(secrets.token_hex(32))"
FERNET_KEY=                       # generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FRONTEND_URL=http://localhost:5173
DATABASE_URL=sqlite:///./workday_agent.db

# --- Google OAuth / Gmail API (REQUIRED — see README.md for full setup steps) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GMAIL_MCP_ENDPOINT=https://gmailmcp.googleapis.com/mcp/v1

# --- LLM: Gemini API (optional — falls back to a rule-based extractor if unset) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ASSISTANT_MAX_OUTPUT_TOKENS=1200

# Bounded concurrency for Gmail fetches and AI extraction
SYNC_WORKER_COUNT=8
